{
  "context-menu": {
    ".tree-view .entry": [
      {
        "type": "separator"
      },
      {
        "label": "Cut (System)",
        "command": "native-clip:cut",
        "afterGroupContaining": ["tree-view:remove", "tree-view:add-file"],
        "after": ["tree-view:paste"]
      },
      {
        "label": "Copy (System)",
        "command": "native-clip:copy"
      },
      {
        "label": "Paste (System)",
        "command": "native-clip:paste"
      },
      {
        "type": "separator"
      }
    ]
  }
}
